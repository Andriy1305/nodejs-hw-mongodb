const parseContact = (value, defaultValue) => {
  if (typeof value === 'undefined') {
    return defaultValue;
  }
  const parsedValue = parseInt(value);
  if (Number.isNaN(parsedValue)) {
    return defaultValue;
  }
  return parsedValue;
};

export const parsePaginationContact = (query) => {
  //console.log('query:', query);
  const { page, perPage } = query;
  //====ДЕФОЛТНІ ЗНАЧЕННЯ НОМЕРУ СТОРІНКИ ТА КІЛЬКІСТЬ ЕЛЕМЕНТІВ НА СТОРІНЦІ//


  const parsedPage = parseContact(page, 1);
  const parsedParPage = parseContact(perPage, 10);

  // console.log(parsedPage, parsedParPage);
  return {
    page: parsedPage,
    perPage: parsedParPage,
  };
};
